# SchemeSaarthi Environment Configuration

# Database Configuration (PostgreSQL for Docker/Production, SQLite default for quick local run)
DATABASE_URL=sqlite:///./scheme_saarthi.db
# For PostgreSQL:
# DATABASE_URL=postgresql://schemesaarthi:schemesaarthi_secret_password@localhost:5432/schemesaarthi_db

# Security & JWT Token
JWT_SECRET=super-secret-schemesaarthi-jwt-key-2026

# Modular AI Engine (Optional - will use high-precision rule-based parser if left blank)
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Scraper Interval in Minutes
SCRAPER_INTERVAL_MINUTES=60
